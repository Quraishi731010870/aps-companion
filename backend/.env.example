# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:8082

# Infrastructure (development values only; replace through a secret manager)
DATABASE_URL=postgresql://afghanpay:CHANGE_ME@localhost:5432/afghanpay?schema=public
REDIS_URL=redis://localhost:6379

# Authentication secrets must be at least 32 random characters.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ADMIN_SESSION_TTL_MINUTES=30
SEED_MOBILE_PHONE=CHANGE_ME_SYNTHETIC_MOBILE_PHONE
SEED_MOBILE_PASSWORD=CHANGE_ME_LOCAL_MOBILE_PASSWORD

# Crash ISO UAT gateway. Sensitive request bodies are never stored or logged.
ISO_API_BASE_URL=http://10.60.76.71:9005
ISO_API_TIMEOUT_MS=30000

# Optional external providers. Empty means the adapter is disabled.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
SMTP_URL=
ZABBIX_API_URL=
ZABBIX_API_TOKEN=
GRAFANA_BASE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
