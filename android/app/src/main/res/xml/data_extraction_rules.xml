<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep app data (including flutter_secure_storage ciphertext)
     out of cloud backups and device-to-device transfers. The Keystore key that
     decrypts it never leaves this device, so restored data would be unreadable. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
