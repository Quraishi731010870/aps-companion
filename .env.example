# Local Docker Compose development values. Copy to .env and replace every CHANGE_ME.
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_ACCESS_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_REFRESH_SECRET_AT_LEAST_32_CHARACTERS
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LOCAL_GRAFANA_PASSWORD
SEED_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ADMIN_PASSWORD
SEED_MOBILE_PHONE=CHANGE_ME_SYNTHETIC_MOBILE_PHONE
SEED_MOBILE_PASSWORD=CHANGE_ME_LOCAL_MOBILE_PASSWORD

# Optional providers; empty values keep their adapters disabled.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
ZABBIX_API_URL=
ZABBIX_API_TOKEN=

# Crash ISO UAT gateway. Keep empty to disable; production requires HTTPS.
ISO_API_BASE_URL=http://10.60.76.71:9005
ISO_API_TIMEOUT_MS=30000
