    { "id": 3, "type": "timeseries", "title": "Backend Memory", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }, "targets": [{ "expr": "afghanpay_process_process_resident_memory_bytes", "legendFormat": "resident" }] },
    { "id": 4, "type": "timeseries", "title": "Host CPU", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }, "targets": [{ "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "legendFormat": "CPU" }] }
